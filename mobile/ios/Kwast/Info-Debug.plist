<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists/1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Только для отладочной сборки: доступ к пилотному серверу в локальной сети по HTTP.
	     Release-сборка этот файл не использует и ходит на сервер только по HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Kwast подключается к пилотному серверу в вашей локальной сети.</string>
</dict>
</plist>
